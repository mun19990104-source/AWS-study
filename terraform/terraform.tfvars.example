# このファイルを terraform.tfvars にコピーして値を埋める
# terraform.tfvars は .gitignore に入れること（db_password が入るため）

key_name    = "my-keypair"
ssh_cidr    = "203.0.113.5/32"
alert_email = "you@example.com"

# db_password は tfvars に書かず、環境変数で渡すのが安全
#   export TF_VAR_db_password='...'

# 任意（デフォルトあり）
# region        = "ap-northeast-1"
# stack_name    = "aws-study"
# instance_type = "t3.micro"
# ami_id        = "ami-088b486f20fab3f0e"
